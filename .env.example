TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮箱推送（QQ、163、Gmail 等均可）
# QQ 邮箱：SMTP_HOST=smtp.qq.com  SMTP_PORT=587
# 163 邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465（或 587）
# Gmail：  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# 密码填 SMTP 授权码，不是登录密码！
# QQ 邮箱授权码获取：设置 → 账户 → POP3/SMTP 服务 → 生成授权码
# 163 授权码获取：设置 → POP3/SMTP/IMAP → 新增授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_authorization_code
EMAIL_TO=receiver@example.com
